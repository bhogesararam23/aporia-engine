model naive_euler_spring "explicit Euler on an oscillator, which has no stable step" {
  input dt in [0.001, 0.3]
  let w = 1
  state x = 1.0
  state v = 0.0
  state energy = 0.5
  loop 41 {
    let x0 = x
    advance x = x + v * dt
    advance v = v - w * w * x0 * dt
    advance energy = 0.5 * v * v + 0.5 * w * w * x * x
    watch energy
  }
  let final = energy
  require final < 0.75
}
