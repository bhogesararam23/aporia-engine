# Shell scripts must stay LF: bash reads them literally and CRLF breaks a reproducible run on
# Windows checkouts. Everything else that is source follows the same rule so diffs stay clean.
*.sh  text eol=lf
*.rs  text eol=lf
*.toml text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.ap  text eol=lf
*.air text eol=lf
*.cu  text eol=lf
*.cuh text eol=lf
*.ptx text eol=lf
*.jl  text eol=lf
*.py  text eol=lf
*.asm text eol=lf
*.s   text eol=lf
*.h   text eol=lf
*.schema.json text eol=lf

# Archive artefacts, whose exact bytes a manifest digests. Without a rule here, a Windows checkout with
# core.autocrlf=true rewrites their line endings and every committed archive fails its own integrity
# check on a fresh clone: `decisions.jsonl` and the `.apx` findings were doing exactly that, which no
# test in the working tree could see because the working tree is where they were written.
*.jsonl text eol=lf
*.apx text eol=lf

*.png binary
*.jpg binary
*.bin binary
*.exe binary
*.lib binary
*.dll binary
*.obj binary
Cargo.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
documentation/*.md text eol=lf
software/examples/* text eol=lf
